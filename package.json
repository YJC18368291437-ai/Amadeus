    "start": "node scripts/start.mjs",
    "pack:plugins": "node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "js-yaml": "4.3.2",
    "ws": "8.21.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12",
    "pdfjs-dist": "5.4.624",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
